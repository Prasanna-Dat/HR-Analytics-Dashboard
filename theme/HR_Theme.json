{
  "name": "HR Analytics Navy-Teal",
  "dataColors": ["#1B4965", "#2E86AB", "#5FA8D3", "#62B6CB", "#F4A261", "#E4572E", "#8AB17D", "#BEE9E8"],
  "background": "#FFFFFF",
  "foreground": "#1B2A3A",
  "tableAccent": "#1B4965",
  "good": "#2E9E6B",
  "neutral": "#F4A261",
  "bad": "#E4572E",
  "maximum": "#1B4965",
  "center": "#BEE9E8",
  "minimum": "#F4A261",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1B2A3A" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A5A6A" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1B4965" }
  },
  "visualStyles": {
    "*": { "*": {
      "title": [{ "show": true, "fontColor": { "solid": { "color": "#1B2A3A" } } }],
      "border": [{ "show": true, "color": { "solid": { "color": "#E1E8EF" } }, "radius": 8 }],
      "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }]
    } },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F3F6F9" } }, "transparency": 0 }] } }
  }
}
